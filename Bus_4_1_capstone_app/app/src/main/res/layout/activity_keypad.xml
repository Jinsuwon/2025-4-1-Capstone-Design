<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- 입력된 값이 표시되는 영역 -->
        <TextView
            android:textSize="50sp"
            android:id="@+id/textViewInput"
            android:layout_width="match_parent"
            android:layout_height="137dp"
            android:layout_marginTop="20dp"
            android:background="#EEEEEE"
            android:gravity="center"
            android:padding="40dp" />

        <!-- 키패드 영역 -->
        <GridLayout
            android:id="@+id/keypadLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:layout_marginTop="40dp">

            <!-- 숫자 및 기호 버튼들 (직접 네모 + 색상 적용) -->
            <android.widget.Button android:id="@+id/btn1" android:text="1" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btn2" android:text="2" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btn3" android:text="3" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btn4" android:text="4" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btn5" android:text="5" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btn6" android:text="6" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btn7" android:text="7" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btn8" android:text="8" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btn9" android:text="9" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btnMinus" android:text="-" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btn0" android:text="0" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>
            <android.widget.Button android:id="@+id/btnDelete" android:text="지우기" android:textStyle="bold" android:textSize="40sp" android:textColor="#000000" android:background="#FFD700" android:layout_width="0dp" android:layout_height="100dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:stateListAnimator="@null"/>

        </GridLayout>

        <!-- 확인 버튼 -->
        <android.widget.Button
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="83dp"
            android:layout_marginTop="24dp"
            android:background="#FFD700"
            android:text="확인"
            android:textColor="#000000"
            android:textSize="40sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </LinearLayout>
</ScrollView>
